# ── Telegram ──────────────────────────────────────────────
# Токен бота-кросспостера от @BotFather (напр. @vastu_syncbot).
TG_BOT_TOKEN=
# ID канала-ИСТОЧНИКА (супергруппа/канал), напр. -1001669592486. Бот должен быть админом канала.
TG_SOURCE_CHAT_ID=-1001669592486
# api_id / api_hash приложения Telegram (my.telegram.org). Можно переиспользовать существующие.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── MAX ───────────────────────────────────────────────────
# Access-токен бота MAX (dev.max.ru → создать бота). Бот должен быть админом канала-приёмника.
MAX_TOKEN=
# ID канала-ПРИЁМНИКА в MAX, напр. -72627929529786.
MAX_CHAT_ID=-72627929529786
# База REST API MAX. Если botapi даёт 404 — попробовать https://platform-api2.max.ru
MAX_API_BASE=https://botapi.max.ru
# Слать chat_id как query-параметр. Должно быть true: в теле MAX отвечает 400 "Unknown recipient".
MAX_CHAT_ID_IN_QUERY=true

# ── Поведение ─────────────────────────────────────────────
ALBUM_DEBOUNCE_MS=1500
