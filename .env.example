# ── Telegram ──────────────────────────────────────────────
# Токен бота-читателя от @BotFather. Бот должен быть админом канала-источника.
TG_BOT_TOKEN=
# ID канала-ИСТОЧНИКА. Узнаётся из лога: "источник вне маршрутов: chat_id=..."
TG_SOURCE_CHAT_ID=-1001234567890
# api_id / api_hash с my.telegram.org — нужны локальному Bot API (видео >20 МБ).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── MAX ───────────────────────────────────────────────────
# Токен бота MAX (dev.max.ru). Бот должен быть админом канала-приёмника.
MAX_TOKEN=
# ID канала-ПРИЁМНИКА в MAX — виден в адресе web.max.ru/-72123456789
MAX_CHAT_ID=-72123456789
# Актуальный домен API с 2026-07-19. Прежние (botapi.max.ru, platform-api.max.ru) устарели.
MAX_API_BASE=https://platform-api2.max.ru
# chat_id как query-параметр. Должно быть true: в теле MAX отвечает 400 "Unknown recipient".
MAX_CHAT_ID_IN_QUERY=true

# ── Маршруты ──────────────────────────────────────────────
# Дополнительные пары каналов через запятую: tg_id:max_id,tg_id:max_id
# Пара выше работает всегда; здесь удобно держать тестовую рядом с боевой.
ROUTES=

# ── Поведение ─────────────────────────────────────────────
# Сколько ждать сборки альбома перед отправкой, мс.
ALBUM_DEBOUNCE_MS=1500
